{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "Install addon",
  "hook": 1,
  "isEnabled": true,
  "content": [
    {
      "id": "5e7b2c40-3a9d-4f61-8c2e-0f5e00000001",
      "Data": {
        "Label": "Find the theme stylesheet",
        "Name": "themeId",
        "Value": "%q:resource[fiftheditiontheme_theme.css].id%"
      },
      "Type": "SetVariable"
    },
    {
      "id": "5e7b2c40-3a9d-4f61-8c2e-0f5e00000002",
      "Data": {
        "Label": "Read the game's stylesheets",
        "ParentId": "%gameId%",
        "PropertyName": "customStylesheets",
        "Output": "current",
        "DefaultValue": "[]"
      },
      "Type": "GetPropertyValue"
    },
    {
      "id": "5e7b2c40-3a9d-4f61-8c2e-0f5e00000003",
      "Data": {
        "Label": "Add the theme, keeping the others",
        "Script": "let list = vars.current;\nif (typeof list === 'string') {\n  try { list = JSON.parse(list || '[]'); } catch (e) { list = []; }\n}\nif (!Array.isArray(list)) list = [];\nif (vars.themeId && list.indexOf(vars.themeId) < 0) list.push(vars.themeId);\nreturn { list: JSON.stringify(list) };"
      },
      "Type": "RunScript"
    },
    {
      "id": "5e7b2c40-3a9d-4f61-8c2e-0f5e00000004",
      "Data": {
        "Label": "Switch the theme on",
        "ParentId": "%gameId%",
        "PropertyName": "customStylesheets",
        "PropertyValue": "%list%"
      },
      "Type": "SetProperty"
    }
  ]
}
